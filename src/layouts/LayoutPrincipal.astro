---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import RadioWidget from '../components/RadioWidget.astro';

interface Props {
  tituloNavegador: string;
  nombreEstacion: string;
  urlStream: string;
  facebook: string;
  whatsapp: string;
  logoUrl?: string;
}

const { tituloNavegador, nombreEstacion, urlStream, facebook, whatsapp, logoUrl } = Astro.props;
---

<html lang="es" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{tituloNavegador}</title> 
    <ClientRouter />
  </head>
  
  <body class="bg-[var(--color-brand-dark)] min-h-screen text-gray-100 font-sans flex flex-col selection:bg-[var(--color-brand-gold)] selection:text-black">
    
    <!-- Navbar global -->
    <div class="navbar bg-base-100/80 backdrop-blur-md sticky top-0 z-40 border-b border-white/10 shadow-lg">
      <div class="navbar-start">
        <div class="dropdown">
          <div tabindex="0" role="button" class="btn btn-ghost lg:hidden">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h8m-8 6h16" /></svg>
          </div>
          <ul tabindex="0" class="menu menu-sm dropdown-content mt-3 z-[1] p-2 shadow bg-base-200 rounded-box w-52">
            <li><a href="/">Inicio</a></li>
            <li><a href="/programacion">Programación</a></li>
            <li><a href={facebook} target="_blank">Facebook</a></li>
            <li><a href={whatsapp} target="_blank">WhatsApp</a></li>
          </ul>
        </div>
        <a href="/" class="btn btn-ghost text-xl text-[var(--color-brand-gold)] font-bold tracking-wider">
          {logoUrl ? <img src={logoUrl} alt={nombreEstacion} class="h-16 object-contain" /> : nombreEstacion}
        </a>
      </div>
      <div class="navbar-center hidden lg:flex">
        <ul class="menu menu-horizontal px-1 font-medium text-gray-300">
          <li><a href="/" class="hover:text-white transition-colors">Inicio</a></li>
          <li><a href="/programacion" class="hover:text-white transition-colors">Programación</a></li>
        </ul>
      </div>
      <div class="navbar-end gap-2 hidden sm:flex">
        <a href={facebook} target="_blank" class="btn btn-ghost btn-circle hover:text-[#1877F2] transition-colors" aria-label="Facebook">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v3.385z"/></svg>
        </a>
        <a href={`https://wa.me/${whatsapp}`} target="_blank" class="btn btn-ghost btn-circle hover:text-[#25D366] transition-colors" aria-label="WhatsApp">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.88-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
        </a>
      </div>
    </div>

    <!-- Contenedor Principal: Full Width -->
    <main class="grow w-full pb-24">
      <slot /> <!-- El contenido dinámico entra por aquí -->
    </main>

    <!-- Footer -->
    <footer class="footer footer-center p-10 bg-base-300 text-base-content rounded pb-32">
      <div class="grid grid-flow-col gap-4">
        <a href="/" class="link link-hover">Inicio</a>
        <a href="/programacion" class="link link-hover">Programación</a>
      </div> 
      <div>
        <div class="grid grid-flow-col gap-4">
          <a href={facebook} target="_blank" aria-label="Facebook">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="hover:text-[var(--color-brand-gold)] transition-colors"><path d="M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v3.385z"/></svg>
          </a> 
          <a href={`https://wa.me/${whatsapp}`} target="_blank" aria-label="WhatsApp">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="hover:text-[var(--color-brand-gold)] transition-colors"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.88-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
          </a>
        </div>
      </div> 
      <div>
        <p>Copyright © {new Date().getFullYear()} - Todos los derechos reservados por {nombreEstacion}</p>
      </div>
    </footer>

    <!-- El Reproductor Fijo Global -->
    <div transition:persist="reproductor-global" class="fixed bottom-0 left-0 w-full z-50 pointer-events-none">
      <div class="pointer-events-auto">
        <RadioWidget 
          nombreEstacion={nombreEstacion} 
          urlStream={urlStream} 
          logoUrl={logoUrl}
        />
      </div>
    </div>

  </body>
</html>