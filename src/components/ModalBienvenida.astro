---
interface Props {
  nombreEstacion: string;
}
const { nombreEstacion } = Astro.props;
---

<dialog id="modal_bienvenida" class="modal modal-bottom sm:modal-middle">
  <div class="modal-box bg-linear-to-br from-[#D4AF37] to-yellow-600 text-[#112A46] shadow-2xl">
    
    <div class="flex justify-between items-center mb-4">
      <h3 class="font-extrabold text-2xl">Bienvenido(a)</h3>
      <div class="animate-pulse flex items-center gap-2">
        <span class="w-3 h-3 bg-red-600 rounded-full inline-block shadow-[0_0_8px_red]"></span>
        <span class="text-xs font-bold text-red-800 uppercase">En vivo</span>
      </div>
    </div>

    <p class="py-2 text-lg font-medium">{nombreEstacion}</p>
    <p class="text-sm opacity-80 mb-6">Toca "Entrar y escuchar" para iniciar la transmisión.</p>
    
    <div class="modal-action m-0">
      <button id="btn-entrar" class="btn bg-[#112A46] text-white w-full border-none hover:bg-gray-900 shadow-lg text-lg">
        ▶ Entrar y escuchar
      </button>
    </div>
  </div>
</dialog>